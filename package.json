{
  "name": "cartoon-sol-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Brand site for CARTOON AI // $CARTOON (@CARTOON_SOL): artwork, clips, archived updates, verified token info",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "data": "node scripts/fetch-timeline.mjs && node scripts/build-data.mjs",
    "sharepages": "node scripts/generate-share-pages.mjs",
    "og": "node scripts/generate-og.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.2.5",
    "@fontsource/delicious-handrawn": "^5.3.0",
    "@fontsource/knewave": "^5.3.0",
    "@fontsource/nunito": "^5.2.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
